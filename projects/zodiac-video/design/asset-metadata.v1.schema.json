{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SeikoP/Project-Agent-Knowledge/blob/main/projects/zodiac-video/design/asset-metadata.v1.schema.json",
  "title": "Storybook Expressive Chibi production asset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "src",
    "category",
    "role",
    "subject_kind",
    "scene_scope",
    "scene_ids",
    "tags",
    "label",
    "description",
    "art_direction_id",
    "art_direction_version",
    "usage",
    "depth_intent",
    "origin",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "src": {
      "type": "string",
      "minLength": 1,
      "pattern": "^assets/video/storybook-expressive-chibi/.+\\.(svg|png|webp)$"
    },
    "category": {
      "enum": [
        "backgrounds",
        "characters",
        "props",
        "decorations",
        "motifs",
        "effects",
        "overlays"
      ]
    },
    "role": {
      "enum": [
        "background",
        "scenery",
        "prop",
        "motif",
        "character"
      ]
    },
    "subject_kind": {
      "enum": [
        "environment",
        "object_prop",
        "symbol",
        "human_character"
      ]
    },
    "scene_scope": {
      "enum": [
        "any",
        "listed"
      ]
    },
    "scene_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "art_direction_id": {
      "const": "storybook-expressive-chibi"
    },
    "art_direction_version": {
      "const": "1"
    },
    "usage": {
      "enum": [
        "interactive",
        "environment",
        "decorative",
        "narrative",
        "performance",
        "effect",
        "overlay"
      ]
    },
    "depth_intent": {
      "enum": [
        "background",
        "midground",
        "interactive_zone",
        "foreground",
        "full_scene",
        "none"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "character_id": {
      "enum": [
        "male-01",
        "male-02",
        "female-01",
        "female-02"
      ]
    },
    "pose": {
      "enum": [
        "standing-neutral",
        "sitting-neutral",
        "talking",
        "listening",
        "gesturing",
        "thinking",
        "looking-away",
        "leaning-in",
        "reading",
        "phone-use",
        "pointing",
        "holding-object",
        "walking"
      ]
    },
    "expression": {
      "enum": [
        "neutral",
        "listening",
        "talking",
        "happy",
        "curious",
        "thinking",
        "awkward",
        "skeptical",
        "surprised",
        "annoyed",
        "sincere"
      ]
    },
    "supported_poses": {
      "type": "array",
      "items": {
        "enum": [
          "standing-neutral",
          "sitting-neutral",
          "talking",
          "listening",
          "gesturing",
          "thinking",
          "looking-away",
          "leaning-in",
          "reading",
          "phone-use",
          "pointing",
          "holding-object",
          "walking"
        ]
      },
      "uniqueItems": true
    },
    "supported_expressions": {
      "type": "array",
      "items": {
        "enum": [
          "neutral",
          "listening",
          "talking",
          "happy",
          "curious",
          "thinking",
          "awkward",
          "skeptical",
          "surprised",
          "annoyed",
          "sincere"
        ]
      },
      "uniqueItems": true
    },
    "state_model": {
      "enum": [
        "identity-master",
        "baked-state",
        "static"
      ]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "head_angle": {
      "type": "number",
      "minimum": -20,
      "maximum": 20
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "depth_group": {
      "type": "string",
      "minLength": 1
    },
    "license_notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scene_scope": {
            "const": "any"
          }
        },
        "required": [
          "scene_scope"
        ]
      },
      "then": {
        "properties": {
          "scene_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene_scope": {
            "const": "listed"
          }
        },
        "required": [
          "scene_scope"
        ]
      },
      "then": {
        "properties": {
          "scene_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "characters"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "character_id",
          "state_model",
          "usage",
          "supported_poses",
          "supported_expressions"
        ],
        "properties": {
          "role": {
            "const": "character"
          },
          "subject_kind": {
            "const": "human_character"
          },
          "usage": {
            "const": "performance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "backgrounds"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "enum": [
              "background",
              "scenery"
            ]
          },
          "subject_kind": {
            "const": "environment"
          },
          "usage": {
            "const": "environment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "props"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "prop"
          },
          "subject_kind": {
            "const": "object_prop"
          },
          "usage": {
            "enum": [
              "interactive",
              "environment",
              "decorative"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "decorations"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "scenery"
          },
          "subject_kind": {
            "const": "environment"
          },
          "usage": {
            "const": "decorative"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "motifs"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "motif"
          },
          "subject_kind": {
            "const": "symbol"
          },
          "usage": {
            "const": "narrative"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "effects"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "motif"
          },
          "subject_kind": {
            "const": "symbol"
          },
          "usage": {
            "const": "effect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "overlays"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "scenery"
          },
          "subject_kind": {
            "const": "symbol"
          },
          "usage": {
            "const": "overlay"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state_model": {
            "const": "baked-state"
          }
        },
        "required": [
          "state_model"
        ]
      },
      "then": {
        "required": [
          "character_id",
          "pose",
          "expression"
        ]
      }
    }
  ]
}
